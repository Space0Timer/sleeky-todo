{
  "extends": ["stylelint-config-standard-scss"],
  "plugins": [
    "stylelint-order",
    "@stylistic/stylelint-plugin",
    "./stylelint/no-unused-use.js"
  ],
  "ignoreFiles": ["dist/**", "node_modules/**"],
  "rules": {
    "sleeky/no-unused-use": true,

    "selector-class-pattern": [
      "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      {
        "message": "Class names are kebab-case; Vite exposes them to components as camelCase"
      }
    ],
    "scss/dollar-variable-pattern": "^-?[a-z][a-z0-9]*(-[a-z0-9]+)*$",
    "scss/at-mixin-pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
    "scss/at-use-no-unnamespaced": true,

    "declaration-no-important": true,
    "@stylistic/color-hex-case": "lower",
    "value-keyword-case": [
      "lower",
      {
        "ignoreKeywords": [
          "optimizeLegibility",
          "Inter",
          "BlinkMacSystemFont",
          "SFMono-Regular",
          "Menlo"
        ]
      }
    ],
    "@stylistic/selector-list-comma-newline-after": "always",

    "property-disallowed-list": [
      ["font-size", "font-weight", "line-height", "letter-spacing"],
      {
        "message": "Use the typography mixin: @include m.typography(<style>). Add a style to $-text-styles in styles/_mixins.scss if none fits"
      }
    ],

    "declaration-property-value-disallowed-list": [
      {
        "/.*/": ["/#[0-9a-fA-F]{3,8}\\b/", "/\\brgba?\\(/", "/\\bhsla?\\(/"],
        "border": ["none"],
        "border-top": ["none"],
        "border-bottom": ["none"],
        "border-left": ["none"],
        "border-right": ["none"],
        "outline": ["none"],
        "text-overflow": ["ellipsis"]
      },
      {
        "message": "Literal colours belong in styles/_tokens.scss, `border: none` should be `border: 0`, and truncation goes through @include m.truncate"
      }
    ],

    "order/order": [
      [
        { "type": "at-rule", "name": "use" },
        "dollar-variables",
        "custom-properties",
        { "type": "at-rule", "name": "include" },
        "declarations",
        "rules"
      ],
      { "unspecified": "ignore" }
    ],

    "order/properties-order": [
      [
        "position",
        "z-index",
        "top",
        "right",
        "bottom",
        "left",
        "inset",

        "display",
        "flex",
        "flex-grow",
        "flex-shrink",
        "flex-basis",
        "flex-flow",
        "flex-direction",
        "flex-wrap",
        "align-items",
        "align-self",
        "align-content",
        "justify-content",
        "justify-self",
        "order",
        "grid",
        "grid-area",
        "grid-template",
        "grid-template-columns",
        "grid-template-rows",
        "grid-template-areas",
        "grid-column",
        "grid-row",
        "grid-auto-flow",
        "grid-auto-columns",
        "grid-auto-rows",

        "width",
        "min-width",
        "max-width",
        "height",
        "min-height",
        "max-height",
        "box-sizing",
        "overflow",
        "overflow-x",
        "overflow-y",
        "resize",

        "padding",
        "padding-top",
        "padding-right",
        "padding-bottom",
        "padding-left",
        "margin",
        "margin-top",
        "margin-right",
        "margin-bottom",
        "margin-left",

        "border",
        "border-width",
        "border-style",
        "border-color",
        "border-top",
        "border-right",
        "border-bottom",
        "border-left",
        "border-top-color",
        "border-right-color",
        "border-bottom-color",
        "border-left-color",
        "border-radius",
        "outline",
        "outline-offset",

        "background",
        "background-color",
        "background-image",
        "background-position",
        "background-size",
        "background-repeat",

        "box-shadow",
        "opacity",
        "visibility",
        "pointer-events",
        "cursor",

        "color",
        "font",
        "font-family",
        "font-size",
        "font-weight",
        "font-style",
        "font-synthesis",
        "line-height",
        "letter-spacing",
        "text-align",
        "text-transform",
        "text-overflow",
        "text-rendering",
        "text-decoration",
        "white-space",
        "word-break",
        "-webkit-font-smoothing",
        "-moz-osx-font-smoothing",

        "gap",
        "row-gap",
        "column-gap",
        "place-items",
        "place-content",
        "justify-items",
        "list-style",

        "transition",
        "transition-property",
        "transition-duration",
        "animation",
        "will-change"
      ],
      { "unspecified": "bottomAlphabetical" }
    ]
  },
  "overrides": [
    {
      "files": ["src/styles/_tokens.scss"],
      "rules": {
        "declaration-property-value-disallowed-list": null
      }
    },
    {
      "files": ["src/styles/_mixins.scss"],
      "rules": {
        "property-disallowed-list": null,
        "declaration-property-value-disallowed-list": [
          {
            "/.*/": ["/#[0-9a-fA-F]{3,8}\\b/", "/\\brgba?\\(/", "/\\bhsla?\\(/"],
            "border": ["none"],
            "outline": ["none"]
          },
          {
            "message": "Literal colours belong in styles/_tokens.scss, and `border: none` should be `border: 0`"
          }
        ]
      }
    }
  ]
}
